{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rekixo-3d-admin",
  "compatibility_date": "2026-10-02",
  "main": "./workers/admin-entry.mjs",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "admin.rekixo.com/3Dprojects",
      "zone_name": "rekixo.com"
    },
    {
      "pattern": "admin.rekixo.com/3Dprojects/*",
      "zone_name": "rekixo.com"
    }
  ],
  "assets": {
    "directory": "./apps/admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/3Dprojects",
      "/3Dprojects/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rekixo-3d-production",
      "database_id": "43423a10-66b2-4460-af5f-f6ab9f2947dc"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MODEL_ASSETS",
      "bucket_name": "rekixo-3d-assets"
    }
  ],
  "containers": [
    {
      "class_name": "DwgProcessor",
      "image": "./services/dwg-processor/Dockerfile",
      "image_build_context": ".",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DWG_PROCESSOR",
        "class_name": "DwgProcessor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-dwg-processor",
      "new_sqlite_classes": ["DwgProcessor"]
    }
  ]
}
