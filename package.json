{
  "name": "rekixo-ar3d-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace @rekixo/3d-admin",
    "dev:public": "npm run dev --workspace @rekixo/3d-public",
    "build": "npm run build --workspace @rekixo/3d-admin && npm run build --workspace @rekixo/3d-public",
    "typecheck": "tsc -p apps/admin/tsconfig.json --noEmit && tsc -p apps/public/tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run build && npm run test:bundles && npm run test:maintainability && node --test tests/*.test.mjs && npm run test:migrations",
    "test:migrations": "node scripts/verify-fresh-migrations.mjs",
    "test:bundles": "node scripts/check-bundle-budgets.mjs",
    "test:maintainability": "node scripts/check-maintainability-budgets.mjs",
    "golden:manifest": "node scripts/certify-golden-source-pack.mjs manifest",
    "golden:certify": "node scripts/certify-golden-source-pack.mjs verify",
    "test:e2e:golden": "playwright test e2e/golden-source-pack.spec.ts --config playwright.config.ts"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.55.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "fake-indexeddb": "6.2.4",
    "meshoptimizer": "0.25.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.146.0"
  },
  "overrides": {
    "source-map-js": "1.2.1"
  }
}
